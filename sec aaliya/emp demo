class Employee {
    int id;
    String name;
    double salary;

    void display() {
        System.out.println(id);
        System.out.println(name);
        System.out.println(salary);
    }

    public static void main(String[] args) {
        Employee e = new Employee();

        e.id = 101;
        e.name = "John";
        e.salary = 25000;

        e.display();
    }
}