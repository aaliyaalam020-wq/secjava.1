import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] candies = new int[n];

        int max = 0;

        for (int i = 0; i < n; i++) {
            candies[i] = sc.nextInt();
            max = Math.max(max, candies[i]);
        }

        int extra = sc.nextInt();

        for (int i = 0; i < n; i++) {
            System.out.print((candies[i] + extra >= max) + " ");
        }
    }
}